# Autlantic Billing app host
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
# Match shopify.app.toml. write_payment_* is granted by the payments extension on first deploy.
SCOPES=read_orders,write_orders

# Autlantic (same portal credentials as WooCommerce / Magento)
AUTLANTIC_BILLING_API_URL=https://billing.autlantic.com
AUTLANTIC_BILLING_API_KEY=abk_test_local
AUTLANTIC_BILLING_MERCHANT_ID=
AUTLANTIC_BILLING_WEBHOOK_SECRET=whsec_test
AUTLANTIC_PAYOUT_ADDRESS_EVM=

# Optional JSON file for local session / activity persistence (single-instance only)
AUTLANTIC_SHOPIFY_STATE_PATH=./.data/state.json
PORT=3458

# Shop token(s) for Payments Apps GraphQL (paymentSessionResolve / Reject)
# SHOPIFY_ACCESS_TOKEN=shpat_…
# or: SHOPIFY_SHOP_TOKENS={"store.myshopify.com":"shpat_…"}
