    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx bin/smoke.ts"
  },
  "dependencies": {
    "@autlantic/payments-recurring": "^0.3.14",
    "@hono/node-server": "^1.14.3",
    "@shopify/shopify-api": "^11.12.0",
    "hono": "^4.7.10",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
