{
  "name": "@autlantic/shopify-billing",
  "version": "1.0.0",
  "private": true,
  "description": "Autlantic Billing offsite payments app for Shopify (USDC on Base)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
